format_account() {
  local response="$1"
  local username=$(echo "$response" | jq -r '.username // "N/A"')
  local credits=$(echo "$response" | jq -r '.credits // "N/A"')
  local plan=$(echo "$response" | jq -r '.plan // "N/A"')

  printf "${bold}Account Information${reset}\n"
  print_divider
  print_kv "Username" "${green}${username}${reset}"
  print_kv "Credits" "${yellow}$(format_number "$credits")${reset}"
  print_kv "Plan" "${cyan}${plan}${reset}"
}

format_user_metadata() {
  local response="$1"
  local username=$(echo "$response" | jq -r '.username // "N/A"')
  local display_name=$(echo "$response" | jq -r '.display_name // "N/A"')
  local bio=$(echo "$response" | jq -r '.bio // "N/A"')
  local followers=$(echo "$response" | jq -r '.followers_count // "N/A"')
  local following=$(echo "$response" | jq -r '.following_count // "N/A"')
  local tweets=$(echo "$response" | jq -r '.tweets_count // "N/A"')
  local verified=$(echo "$response" | jq -r '.verified // false')
  local created_at=$(echo "$response" | jq -r '.created_at // "N/A"')
  local location=$(echo "$response" | jq -r '.location // "N/A"')
  local website=$(echo "$response" | jq -r '.website // "N/A"')

  printf "${bold}User: ${green}@%s${reset}\n" "$username"
  print_divider
  [ "$display_name" != "N/A" ] && print_kv "Display Name" "${blue}${display_name}${reset}"
  [ "$bio" != "N/A" ] && print_kv "Bio" "$bio"
  [ "$location" != "N/A" ] && print_kv "Location" "${magenta}${location}${reset}"
  [ "$website" != "N/A" ] && print_kv "Website" "${blue}${website}${reset}"

  print_section "Statistics"
  printf "  ${cyan}Followers:${reset} ${yellow}%s${reset}\n" "$(format_number "$followers")"
  printf "  ${cyan}Following:${reset} ${yellow}%s${reset}\n" "$(format_number "$following")"
  printf "  ${cyan}Tweets:${reset} ${yellow}%s${reset}\n" "$(format_number "$tweets")"
  printf "  ${cyan}Verified:${reset} %s\n" "$([ "$verified" = "true" ] && echo "${green}✓ Yes${reset}" || echo "${red}✗ No${reset}")"
  [ "$created_at" != "N/A" ] && printf "  ${cyan}Created:${reset} ${yellow}%s${reset}\n" "$(format_timestamp "$created_at")"
}

format_tweets() {
  local response="$1"
  local count=$(echo "$response" | jq -r '. | length')

  printf "${bold}Tweets${reset} ${dim}(${yellow}%s${dim} found)${reset}\n" "$count"
  print_divider

  echo "$response" | jq -r '.[] | "\(.id)|\(.text)|\(.created_at)|\(.retweet_count // 0)|\(.favorite_count // 0)|\(.reply_count // 0)"' |
    while IFS="|" read -r tweet_id text created_at retweets likes replies; do
      printf "\n${bold}${cyan}%s${reset} ${dim}•${reset} ${yellow}%s${reset}\n" "$tweet_id" "$(format_timestamp "$created_at")"

      # format tweet text with word wrapping
      printf "%s\n" "$text" | fold -w 80 -s

      printf "\n${dim}Stats:${reset} "
      printf "${green}%s${reset} retweets" "$(format_number "$retweets")"
      printf " ${dim}•${reset} ${red}%s${reset} likes" "$(format_number "$likes")"
      [ "$replies" != "0" ] && printf " ${dim}•${reset} ${blue}%s${reset} replies" "$(format_number "$replies")"
      printf "\n"

      print_divider
    done
}

format_followers() {
  local response="$1"
  local count=$(echo "$response" | jq -r '. | length')

  printf "${bold}Users${reset} ${dim}(${yellow}%s${dim} found)${reset}\n" "$count"
  print_divider

  echo "$response" | jq -r '.[] | "\(.username)|\(.display_name // "N/A")|\(.followers_count // 0)|\(.following_count // 0)|\(.score // "N/A")|\(.verified // false)"' |
    while IFS="|" read -r username display_name followers following score verified; do
      printf "\n${bold}@%s${reset}" "$username"
      [ "$display_name" != "N/A" ] && printf " ${dim}(${blue}%s${reset}${dim})${reset}" "$display_name"
      [ "$verified" = "true" ] && printf " ${green}✓${reset}"
      printf "\n"

      printf "  ${cyan}Followers:${reset} ${yellow}%s${reset}" "$(format_number "$followers")"
      printf " ${dim}•${reset} ${cyan}Following:${reset} ${yellow}%s${reset}" "$(format_number "$following")"
      [ "$score" != "N/A" ] && printf " ${dim}•${reset} ${cyan}Score:${reset} ${green}%s${reset}" "$score"
      printf "\n"
    done
}

format_score() {
  local response="$1"
  local username=$(echo "$response" | jq -r '.username // "N/A"')
  local score=$(echo "$response" | jq -r '.score // "N/A"')
  local rank=$(echo "$response" | jq -r '.rank // "N/A"')
  local classification=$(echo "$response" | jq -r '.classification // "N/A"')
  local timestamp=$(echo "$response" | jq -r '.timestamp // "N/A"')

  printf "${bold}Score for ${green}@%s${reset}\n" "$username"
  print_divider
  print_kv "Score" "${yellow}${score}${reset}"
  [ "$rank" != "N/A" ] && print_kv "Rank" "${cyan}#$(format_number "$rank")${reset}"
  [ "$classification" != "N/A" ] && print_kv "Classification" "${magenta}${classification}${reset}"
  [ "$timestamp" != "N/A" ] && print_kv "Updated" "${dim}$(format_timestamp "$timestamp")${reset}"
}

format_simple_list() {
  local response="$1"
  local title="$2"
  local count=$(echo "$response" | jq -r '. | length // 0')

  printf "${bold}%s${reset} ${dim}(${yellow}%s${dim} found)${reset}\n" "$title" "$count"
  print_divider

  echo "$response" | jq -r '.[]' | while read -r item; do
    printf "${green}%s${reset}\n" "$item"
  done
}

format_past_usernames() {
  local response="$1"
  local username="$2"

  # extract the data array from the response
  local data=$(echo "$response" | jq -r '.data // []')
  local count=$(echo "$data" | jq -r '. | length // 0')

  printf "${bold}Past Usernames for ${green}@%s${reset} ${dim}(${yellow}%s${dim} found)${reset}\n" "$username" "$count"
  print_divider

  if echo "$data" | jq -e '.[0].username' >/dev/null 2>&1; then
    echo "$data" | jq -r '.[] | "\(.username)|\(.last_checked // "N/A")"' |
      while IFS="|" read -r past_username last_checked; do
        printf "${green}%-20s${reset}" "$past_username"
        if [ "$last_checked" != "N/A" ]; then
          printf " ${dim}(last seen: ${yellow}%s${reset}${dim})${reset}" "$(format_timestamp "$last_checked")"
        fi
        printf "\n"
      done
  else
    echo "$data" | jq -r '.[]' | while read -r item; do
      printf "${green}%s${reset}\n" "$item"
    done
  fi
}

validate_required() {
  local value="$1"
  local name="$2"
  if [ -z "$value" ]; then
    echo "${red}Error:${reset} $name is required." >&2
    exit 1
  fi
}

if [ -z "$argc_command" ]; then
  show_help
  exit 0
fi

case "$argc_command" in
# Account & Info commands
account)
  response=$(make_request "GET" "get_my_account")
  [ "$argc_json" = 1 ] && echo "$response" | jq || format_account "$response"
  ;;

info)
  response=$(make_request "GET" "info")
  [ "$argc_json" = 1 ] && echo "$response" | jq || echo "$response" | jq
  ;;

# Alpha commands
classification)
  validate_required "$argc_value" "Username"
  payload=$(build_user_payload "$argc_value")
  response=$(make_request "POST" "alpha/get_classification" "$payload")
  [ "$argc_json" = 1 ] && echo "$response" | jq || format_score "$response"
  ;;

score)
  validate_required "$argc_value" "Username"
  payload=$(build_user_payload "$argc_value")
  response=$(make_request "POST" "alpha/get_score" "$payload")
  [ "$argc_json" = 1 ] && echo "$response" | jq || format_score "$response"
  ;;

score-history)
  validate_required "$argc_value" "Username"
  payload=$(build_user_payload "$argc_value")
  response=$(make_request "POST" "alpha/get_score_history" "$payload")
  [ "$argc_json" = 1 ] && echo "$response" | jq || echo "$response" | jq
  ;;

# Metadata commands
bio-history)
  validate_required "$argc_value" "Username"
  payload=$(build_user_payload "$argc_value")
  response=$(make_request "POST" "metadata/get_bio_history" "$payload")
  [ "$argc_json" = 1 ] && echo "$response" | jq || echo "$response" | jq
  ;;

current-metadata)
  validate_required "$argc_value" "Username"
  payload=$(build_user_payload "$argc_value")
  response=$(make_request "POST" "metadata/get_current_metadata" "$payload")
  [ "$argc_json" = 1 ] && echo "$response" | jq || format_user_metadata "$response"
  ;;

metadata-history)
  validate_required "$argc_value" "Username"
  payload=$(build_user_payload "$argc_value")
  response=$(make_request "POST" "metadata/get_metadata_history" "$payload")
  [ "$argc_json" = 1 ] && echo "$response" | jq || echo "$response" | jq
  ;;

follower-count | following-count | tweet-count)
  validate_required "$argc_value" "Username"
  payload=$(build_user_payload "$argc_value")
  case "$argc_command" in
  follower-count) endpoint="metadata/get_current_num_followers" ;;
  following-count) endpoint="metadata/get_current_num_following" ;;
  tweet-count) endpoint="metadata/get_current_num_tweets" ;;
  esac
  response=$(make_request "POST" "$endpoint" "$payload")
  if [ "$argc_json" = 1 ]; then
    echo "$response" | jq
  else
    count=$(echo "$response" | jq -r '. // "N/A"')
    printf "${bold}%s:${reset} ${yellow}%s${reset}\n" "${argc_command//-/ }" "$(format_number "$count")"
  fi
  ;;

latest-metadata)
  validate_required "$argc_value" "Username"
  payload=$(build_user_payload "$argc_value")
  response=$(make_request "POST" "metadata/get_latest_metadata" "$payload")
  [ "$argc_json" = 1 ] && echo "$response" | jq || format_user_metadata "$response"
  ;;

userid)
  validate_required "$argc_value" "Username"
  payload=$(build_user_payload "$argc_value")
  response=$(make_request "POST" "metadata/get_userid" "$payload")
  if [ "$argc_json" = 1 ]; then
    echo "$response" | jq
  else
    userid=$(echo "$response" | jq -r '.userid // "N/A"')
    printf "${bold}User ID for @%s:${reset} ${cyan}%s${reset}\n" "$argc_value" "$userid"
  fi
  ;;

past-usernames)
  validate_required "$argc_value" "Username"
  payload=$(build_user_payload "$argc_value")
  response=$(make_request "POST" "metadata/get_past_usernames" "$payload")
  [ "$argc_json" = 1 ] && echo "$response" | jq || format_past_usernames "$response" "$argc_value"
  ;;

deleted-tweets)
  validate_required "$argc_value" "Username"
  payload=$(build_user_payload "$argc_value")
  response=$(make_request "POST" "metadata/get_deleted_tweets" "$payload")
  [ "$argc_json" = 1 ] && echo "$response" | jq || format_tweets "$response"
  ;;

# Tweet commands
tweets | latest-tweets)
  validate_required "$argc_value" "Username"
  payload=$(build_user_payload "$argc_value")
  endpoint="metadata/get_$([ "$argc_command" = "latest-tweets" ] && echo "latest_" || echo "")tweets"
  response=$(make_request "POST" "$endpoint" "$payload")
  [ "$argc_json" = 1 ] && echo "$response" | jq || format_tweets "$response"
  ;;

tweets-by-ids)
  validate_required "$argc_tweet_ids" "Tweet IDs (use --tweet-ids)"
  IFS=',' read -ra tweet_array <<<"$argc_tweet_ids"
  if [ ${#tweet_array[@]} -gt 20 ]; then
    echo "${red}Error:${reset} Maximum 20 tweet IDs allowed." >&2
    exit 1
  fi
  tweet_ids_json=$(printf '%s\n' "${tweet_array[@]}" | jq -R . | jq -s .)
  payload="{\"tweet_ids\": $tweet_ids_json}"
  response=$(make_request "POST" "metadata/get_tweets_by_ids" "$payload")
  [ "$argc_json" = 1 ] && echo "$response" | jq || format_tweets "$response"
  ;;

# Graph commands
first-followers | followers | following | scored-followers)
  validate_required "$argc_value" "Username"
  payload=$(build_user_payload "$argc_value")
  endpoint="graph/get_$(echo "$argc_command" | tr '-' '_')"
  response=$(make_request "POST" "$endpoint" "$payload")
  [ "$argc_json" = 1 ] && echo "$response" | jq || format_followers "$response"
  ;;

# List commands
list-members)
  validate_required "$argc_value" "List ID"
  payload="{\"list_id\": \"$argc_value\", \"page\": $argc_page}"
  response=$(make_request "POST" "lists/get_list_members" "$payload")
  [ "$argc_json" = 1 ] && echo "$response" | jq || format_followers "$response"
  ;;

list-tweets)
  validate_required "$argc_value" "List ID"
  payload="{\"list_id\": \"$argc_value\", \"page\": $argc_page}"
  response=$(make_request "POST" "lists/get_latest_list_tweets" "$payload")
  [ "$argc_json" = 1 ] && echo "$response" | jq || format_tweets "$response"
  ;;

# Cyclone commands
cyclone-tweets)
  # Validate num_rows
  if [ "$argc_num_rows" -gt 100 ]; then
    echo "${red}Error:${reset} Maximum 100 rows allowed." >&2
    exit 1
  fi

  payload="{\"num_rows\": $argc_num_rows"
  [ -n "$argc_since" ] && {
    if [[ "$argc_since" =~ ^[0-9]+$ ]]; then
      payload="$payload, \"tweets_since\": $argc_since"
    else
      payload="$payload, \"users_since\": \"$argc_since\""
    fi
  }
  payload="$payload}"
  response=$(make_request "POST" "cyclone/get_cyclone_tweets" "$payload")
  [ "$argc_json" = 1 ] && echo "$response" | jq || format_tweets "$response"
  ;;

*)
  echo "${red}Error:${reset} Unknown command: ${argc_command}" >&2
  show_help
  exit 1
  ;;
esac
