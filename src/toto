format_account() {
  local response="$1"
  local credits=$(echo "$response" | jq -r '.current_credits // .credits // "N/A"')
  local subscriptions=$(echo "$response" | jq -r '.subscriptions // [] | length')

  printf "${bold}Account Information${reset}\n"
  print_divider
  print_kv "Credits" "${yellow}$(format_number "$credits")${reset}"
  if [ "$subscriptions" -gt 0 ]; then
    print_kv "Active Subscriptions" "${green}${subscriptions}${reset}"
  else
    print_kv "Subscription Status" "${dim}No active subscriptions${reset}"
  fi
}

format_user_metadata() {
  local response="$1"
  local username=$(echo "$response" | jq -r '.username // "N/A"')
  local display_name=$(echo "$response" | jq -r '.display_name // "N/A"')
  local bio=$(echo "$response" | jq -r '.bio // "N/A"')
  local followers=$(echo "$response" | jq -r '.followers_count // "N/A"')
  local following=$(echo "$response" | jq -r '.following_count // "N/A"')
  local tweets=$(echo "$response" | jq -r '.tweets_count // "N/A"')
  local verified=$(echo "$response" | jq -r '.verified // false')
  local created_at=$(echo "$response" | jq -r '.created_at // "N/A"')
  local location=$(echo "$response" | jq -r '.location // "N/A"')
  local website=$(echo "$response" | jq -r '.website // "N/A"')

  printf "${bold}User: ${green}@%s${reset}\n" "$username"
  print_divider
  [ "$display_name" != "N/A" ] && print_kv "Display Name" "${blue}${display_name}${reset}"
  [ "$bio" != "N/A" ] && print_kv "Bio" "$bio"
  [ "$location" != "N/A" ] && print_kv "Location" "${magenta}${location}${reset}"
  [ "$website" != "N/A" ] && print_kv "Website" "${blue}${website}${reset}"

  print_section "Statistics"
  printf "  ${cyan}Followers:${reset} ${yellow}%s${reset}\n" "$(format_number "$followers")"
  printf "  ${cyan}Following:${reset} ${yellow}%s${reset}\n" "$(format_number "$following")"
  printf "  ${cyan}Tweets:${reset} ${yellow}%s${reset}\n" "$(format_number "$tweets")"
  printf "  ${cyan}Verified:${reset} %s\n" "$([ "$verified" = "true" ] && echo "${green}✓ Yes${reset}" || echo "${red}✗ No${reset}")"
  [ "$created_at" != "N/A" ] && printf "  ${cyan}Created:${reset} ${yellow}%s${reset}\n" "$(format_timestamp "$created_at")"
}

format_tweets() {
  local response="$1"
  local title="${2:-Tweets}"
  local count=$(echo "$response" | jq -r '. | length')

  printf "${bold}%s${reset} ${dim}(${yellow}%s${dim} found)${reset}\n" "$title" "$count"
  print_divider

  if [ "$count" -eq 0 ]; then
    printf "${dim}No tweets found${reset}\n"
    return
  fi

  # Process each tweet as a JSON object to handle multi-line text correctly
  local i=0
  while [ $i -lt $count ]; do
    local tweet=$(echo "$response" | jq ".[$i]")
    
    local tweet_id=$(echo "$tweet" | jq -r '.id // .tweet_id // "N/A"')
    local text=$(echo "$tweet" | jq -r '.text // .full_text // .tweet_text // "N/A"')
    local created_at=$(echo "$tweet" | jq -r '.created_at // .tweet_time // .timestamp // "N/A"')
    local retweets=$(echo "$tweet" | jq -r '.retweet_count // .retweets // 0')
    local likes=$(echo "$tweet" | jq -r '.favorite_count // .likes // 0')
    local replies=$(echo "$tweet" | jq -r '.reply_count // .replies // 0')
    
    printf "\n${bold}${cyan}%s${reset} ${dim}•${reset} ${yellow}%s${reset}\n" "$tweet_id" "$(format_timestamp "$created_at")"
    
    # format tweet text with word wrapping
    printf "%s\n" "$text" | fold -w 80 -s
    
    printf "\n${dim}Stats:${reset} "
    printf "${green}%s${reset} retweets" "$(format_number "$retweets")"
    printf " ${dim}•${reset} ${red}%s${reset} likes" "$(format_number "$likes")"
    [ "$replies" != "0" ] && [ "$replies" != "N/A" ] && printf " ${dim}•${reset} ${blue}%s${reset} replies" "$(format_number "$replies")"
    printf "\n"
    
    print_divider
    
    i=$((i + 1))
  done
}

format_followers() {
  local response="$1"
  local title="${2:-Users}"
  local count=$(echo "$response" | jq -r '. | length')

  printf "${bold}%s${reset} ${dim}(${yellow}%s${dim} found)${reset}\n" "$title" "$count"
  print_divider

  # Check if this is a follower/following response with special structure
  if echo "$response" | jq -e '.[0].follower_username' >/dev/null 2>&1; then
    echo "$response" | jq -r '.[] | "\(.follower_username // .username)|\(.follower_bio // .bio // "")|\(.follower_num_followers // .num_followers // 0)|\(.follower_num_friends // .num_friends // 0)|\(.follower_score // .score // "N/A")|\(.follower_account_type_str // .account_type_str // "")"' |
      while IFS="|" read -r username bio followers following score account_type; do
        printf "\n${bold}@%s${reset}" "$username"
        [ -n "$account_type" ] && printf " ${dim}(${magenta}%s${reset}${dim})${reset}" "$account_type"
        printf "\n"
        
        [ -n "$bio" ] && printf "  ${dim}%s${reset}\n" "$(echo "$bio" | fold -w 70 -s | sed '2,$s/^/  /')"
        
        printf "  ${cyan}Followers:${reset} ${yellow}%s${reset}" "$(format_number "$followers")"
        printf " ${dim}•${reset} ${cyan}Following:${reset} ${yellow}%s${reset}" "$(format_number "$following")"
        [ "$score" != "N/A" ] && printf " ${dim}•${reset} ${cyan}Score:${reset} ${green}%s${reset}" "$score"
        printf "\n"
      done
  else
    # Standard user list format
    echo "$response" | jq -r '.[] | "\(.username)|\(.display_name // .bio // "")|\(.followers_count // .num_followers // 0)|\(.following_count // .num_friends // 0)|\(.score // "N/A")|\(.verified // false)"' |
      while IFS="|" read -r username display_name followers following score verified; do
        printf "\n${bold}@%s${reset}" "$username"
        [ -n "$display_name" ] && [ "$display_name" != "N/A" ] && printf " ${dim}(%s)${reset}" "$display_name"
        [ "$verified" = "true" ] && printf " ${green}✓${reset}"
        printf "\n"

        printf "  ${cyan}Followers:${reset} ${yellow}%s${reset}" "$(format_number "$followers")"
        printf " ${dim}•${reset} ${cyan}Following:${reset} ${yellow}%s${reset}" "$(format_number "$following")"
        [ "$score" != "N/A" ] && printf " ${dim}•${reset} ${cyan}Score:${reset} ${green}%s${reset}" "$score"
        printf "\n"
      done
  fi
}

format_score() {
  local response="$1"
  
  # Check if response has data array
  if echo "$response" | jq -e '.data[0]' >/dev/null 2>&1; then
    local data=$(echo "$response" | jq '.data[0]')
    local username=$(echo "$data" | jq -r '.username // "N/A"')
    local score=$(echo "$data" | jq -r '.score // "N/A"')
    local rank=$(echo "$data" | jq -r '.rank // "N/A"')
    local classification=$(echo "$data" | jq -r '.classification // "N/A"')
    local timestamp=$(echo "$data" | jq -r '.timestamp // "N/A"')
  else
    local username=$(echo "$response" | jq -r '.username // "N/A"')
    local score=$(echo "$response" | jq -r '.score // "N/A"')
    local rank=$(echo "$response" | jq -r '.rank // "N/A"')
    local classification=$(echo "$response" | jq -r '.classification // "N/A"')
    local timestamp=$(echo "$response" | jq -r '.timestamp // "N/A"')
  fi

  printf "${bold}Score for ${green}@%s${reset}\n" "$username"
  print_divider
  print_kv "Score" "${yellow}${score}${reset}"
  [ "$rank" != "N/A" ] && print_kv "Rank" "${cyan}#$(format_number "$rank")${reset}"
  [ "$classification" != "N/A" ] && print_kv "Classification" "${magenta}${classification}${reset}"
  [ "$timestamp" != "N/A" ] && print_kv "Updated" "${dim}$(format_timestamp "$timestamp")${reset}"
}

format_simple_list() {
  local response="$1"
  local title="$2"
  local count=$(echo "$response" | jq -r '. | length // 0')

  printf "${bold}%s${reset} ${dim}(${yellow}%s${dim} found)${reset}\n" "$title" "$count"
  print_divider

  echo "$response" | jq -r '.[]' | while read -r item; do
    printf "${green}%s${reset}\n" "$item"
  done
}

format_past_usernames() {
  local response="$1"
  local username="$2"

  # extract the data array from the response
  local data=$(echo "$response" | jq -r '.data // []')
  local count=$(echo "$data" | jq -r '. | length // 0')

  printf "${bold}Past Usernames for ${green}@%s${reset} ${dim}(${yellow}%s${dim} found)${reset}\n" "$username" "$count"
  print_divider

  if echo "$data" | jq -e '.[0].username' >/dev/null 2>&1; then
    echo "$data" | jq -r '.[] | "\(.username)|\(.last_checked // "N/A")"' |
      while IFS="|" read -r past_username last_checked; do
        printf "${green}%-20s${reset}" "$past_username"
        if [ "$last_checked" != "N/A" ]; then
          printf " ${dim}(last seen: ${yellow}%s${reset}${dim})${reset}" "$(format_timestamp "$last_checked")"
        fi
        printf "\n"
      done
  else
    echo "$data" | jq -r '.[]' | while read -r item; do
      printf "${green}%s${reset}\n" "$item"
    done
  fi
}

format_bio_history() {
  local response="$1"
  local username="$2"
  local count=$(echo "$response" | jq -r '. | length // 0')

  printf "${bold}Bio History for ${green}@%s${reset} ${dim}(${yellow}%s${dim} entries)${reset}\n" "$username" "$count"
  print_divider

  echo "$response" | jq -r '.[] | "\(.bio // "N/A")|\(.timestamp // "N/A")"' |
    while IFS="|" read -r bio timestamp; do
      printf "\n${yellow}%s${reset}\n" "$(format_timestamp "$timestamp")"
      printf "%s\n" "$bio" | fold -w 80 -s
      print_divider
    done
}

format_metadata_history() {
  local response="$1"
  local username="$2"
  local count=$(echo "$response" | jq -r '. | length // 0')

  printf "${bold}Metadata History for ${green}@%s${reset} ${dim}(${yellow}%s${dim} entries)${reset}\n" "$username" "$count"
  print_divider

  echo "$response" | jq -r '.[] | @base64' |
    while read -r entry; do
      local decoded=$(echo "$entry" | base64 -d)
      local display_name=$(echo "$decoded" | jq -r '.display_name // "N/A"')
      local bio=$(echo "$decoded" | jq -r '.bio // "N/A"')
      local followers=$(echo "$decoded" | jq -r '.followers_count // "N/A"')
      local following=$(echo "$decoded" | jq -r '.following_count // "N/A"')
      local tweets=$(echo "$decoded" | jq -r '.tweets_count // "N/A"')
      local timestamp=$(echo "$decoded" | jq -r '.timestamp // "N/A"')

      printf "\n${yellow}%s${reset}\n" "$(format_timestamp "$timestamp")"
      [ "$display_name" != "N/A" ] && print_kv "Display Name" "$display_name"
      [ "$bio" != "N/A" ] && print_kv "Bio" "$bio"
      printf "  ${cyan}Followers:${reset} ${yellow}%s${reset}" "$(format_number "$followers")"
      printf " ${dim}•${reset} ${cyan}Following:${reset} ${yellow}%s${reset}" "$(format_number "$following")"
      printf " ${dim}•${reset} ${cyan}Tweets:${reset} ${yellow}%s${reset}\n" "$(format_number "$tweets")"
      print_divider
    done
}

format_score_history() {
  local response="$1"
  local username="$2"
  local count=$(echo "$response" | jq -r '. | length // 0')

  printf "${bold}Score History for ${green}@%s${reset} ${dim}(${yellow}%s${dim} entries)${reset}\n" "$username" "$count"
  print_divider

  echo "$response" | jq -r '.[] | "\(.score // "N/A")|\(.rank // "N/A")|\(.classification // "N/A")|\(.timestamp // "N/A")"' |
    while IFS="|" read -r score rank classification timestamp; do
      printf "\n${yellow}%s${reset}\n" "$(format_timestamp "$timestamp")"
      printf "  ${cyan}Score:${reset} ${yellow}%s${reset}" "$score"
      [ "$rank" != "N/A" ] && printf " ${dim}•${reset} ${cyan}Rank:${reset} ${yellow}#%s${reset}" "$(format_number "$rank")"
      [ "$classification" != "N/A" ] && printf " ${dim}•${reset} ${cyan}Class:${reset} ${magenta}%s${reset}" "$classification"
      printf "\n"
    done
}

format_info() {
  local response="$1"
  local version=$(echo "$response" | jq -r '.api_version // .version // "N/A"')
  local release_date=$(echo "$response" | jq -r '.release_date // "N/A"')
  local message=$(echo "$response" | jq -r '.message // "N/A"')

  printf "${bold}TOTO API Information${reset}\n"
  print_divider
  print_kv "API Version" "${cyan}${version}${reset}"
  [ "$release_date" != "N/A" ] && print_kv "Release Date" "${yellow}${release_date}${reset}"
  [ "$message" != "N/A" ] && print_kv "Message" "${green}${message}${reset}"
}

validate_required() {
  local value="$1"
  local name="$2"
  if [ -z "$value" ]; then
    echo "${red}Error:${reset} $name is required." >&2
    exit 1
  fi
}

if [ -z "$argc_command" ]; then
  show_help
  exit 0
fi

case "$argc_command" in
# Account & Info commands
account)
  response=$(make_request "GET" "get_my_account")
  [ "$argc_json" = 1 ] && echo "$response" | jq || format_account "$response"
  ;;

info)
  response=$(make_request "GET" "info")
  [ "$argc_json" = 1 ] && echo "$response" | jq || format_info "$response"
  ;;

# Alpha commands
classification)
  validate_required "$argc_value" "Username"
  payload=$(build_user_payload "$argc_value")
  response=$(make_request "POST" "alpha/get_classification" "$payload")
  if [ "$argc_json" = 1 ]; then
    echo "$response" | jq
  else
    # Check if response has data array for classification
    if echo "$response" | jq -e '.data[0]' >/dev/null 2>&1; then
      data=$(echo "$response" | jq '.data[0]')
      username=$(echo "$data" | jq -r '.username // "N/A"')
      classification=$(echo "$data" | jq -r '.classification // "N/A"')
      
      printf "${bold}Classification for ${green}@%s${reset}\n" "$username"
      print_divider
      print_kv "Classification" "${magenta}${classification}${reset}"
    else
      format_score "$response"
    fi
  fi
  ;;

score)
  validate_required "$argc_value" "Username"
  payload=$(build_user_payload "$argc_value")
  response=$(make_request "POST" "alpha/get_score" "$payload")
  [ "$argc_json" = 1 ] && echo "$response" | jq || format_score "$response"
  ;;

