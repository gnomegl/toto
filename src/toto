  response=$(make_request "POST" "metadata/get_metadata_history" "$payload")
  [ "$argc_json" = 1 ] && echo "$response" | jq || format_metadata_history "$response" "$argc_value"
  ;;

follower-count | following-count | tweet-count)
  validate_required "$argc_value" "Username"
  payload=$(build_user_payload "$argc_value")
  case "$argc_command" in
  follower-count) 
    endpoint="metadata/get_current_num_followers"
    field="num_followers"
    ;;
  following-count) 
    endpoint="metadata/get_current_num_following"
    field="num_following"
    ;;
  tweet-count) 
    endpoint="metadata/get_current_num_tweets"
    field="num_tweets"
    ;;
  esac
  response=$(make_request "POST" "$endpoint" "$payload")
  if [ "$argc_json" = 1 ]; then
    echo "$response" | jq
  else
    # Check if response has data array
    if echo "$response" | jq -e '.data[0]' >/dev/null 2>&1; then
      count=$(echo "$response" | jq -r ".data[0].$field // \"N/A\"")
      username=$(echo "$response" | jq -r '.data[0].username // "N/A"')
    else
      count=$(echo "$response" | jq -r ". // \"N/A\"")
      username="$argc_value"
    fi
    label=$(echo "${argc_command//-/ }" | sed 's/\b\(.\)/\u\1/g')
    printf "${bold}%s for ${green}@%s${reset}: ${yellow}%s${reset}\n" "$label" "$username" "$(format_number "$count")"
  fi
  ;;

latest-metadata)
