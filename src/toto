#!/usr/bin/env bash

# @describe TOTO API client for crypto socials on X/Twitter
# @arg command "Command to run" [string]
# @arg value "Username, list ID, or other identifier" [string]
# @option -k --key "TOTO API key (can also use TOTO_API_KEY env var)" [string]
# @option -h --how "Lookup method: username or userid" [string] @default "username"
# @option -p --page "Page number for pagination" [int] @default "1"
# @option -n --num-rows "Number of rows to return (max 100)" [int] @default "100"
# @option -s --since "Filter results since this datetime or ID" [string]
# @option -t --tweet-ids "Comma-separated list of tweet IDs (max 20)" [string]
# @flag   -w --with-pfp "Include profile image (increases latency)"
# @flag   -j --json "Output raw JSON instead of formatted results"
# @flag   -q --quiet "Suppress colored output"
# @flag   -v --verbose "Show detailed request information"
# @meta require-tools curl,jq

eval "$(argc --argc-eval "$0" "$@")"

setup_colors() {
  if [ "$argc_quiet" = 1 ] || [ -z "$TERM" ] || [ "$TERM" = "dumb" ]; then
    bold="" reset="" blue="" green="" yellow="" cyan="" magenta="" red="" dim=""
  else
    bold=$(tput bold) reset=$(tput sgr0) blue=$(tput setaf 4) green=$(tput setaf 2)
    yellow=$(tput setaf 3) cyan=$(tput setaf 6) magenta=$(tput setaf 5) red=$(tput setaf 1)
    dim=$(tput dim)
  fi
}
setup_colors

get_api_key() {
  if [ -n "$argc_key" ]; then
    echo "$argc_key"
  elif [ -n "$TOTO_API_KEY" ]; then
    echo "$TOTO_API_KEY"
  elif [ -f "$HOME/.config/toto/api_key" ]; then
    cat "$HOME/.config/toto/api_key"
  else
    echo "${red}Error:${reset} No TOTO API key found." >&2
    echo "Either:" >&2
    echo "  1. Pass it with --key" >&2
    echo "  2. Set TOTO_API_KEY environment variable" >&2
    echo "  3. Save it to ~/.config/toto/api_key" >&2
    exit 1
  fi
}
API_KEY=$(get_api_key)
API_BASE="https://toto.oz.xyz/api"

print_kv() {
  printf "${bold}%s:${reset} %s\n" "$1" "$2"
}

print_section() {
  printf "\n${bold}%s:${reset}\n" "$1"
}

print_divider() {
  printf "${dim}%s${reset}\n" "$(printf '─%.0s' {1..80})"
}

format_timestamp() {
  local timestamp="$1"
  if [ -z "$timestamp" ] || [ "$timestamp" = "null" ] || [ "$timestamp" = "N/A" ]; then
    echo "N/A"
    return
  fi

  # Handle both Unix timestamps and ISO dates
  if [[ "$timestamp" =~ ^[0-9]+$ ]]; then
    # Unix timestamp
    if command -v date >/dev/null 2>&1; then
      if date -d "@$timestamp" >/dev/null 2>&1; then
        date -d "@$timestamp" "+%Y-%m-%d %H:%M:%S UTC"
      elif date -r "$timestamp" >/dev/null 2>&1; then
        date -r "$timestamp" "+%Y-%m-%d %H:%M:%S UTC"
      else
        echo "$timestamp"
      fi
    else
      echo "$timestamp"
    fi
  else
    # ISO date string - try to parse it nicely
    if command -v date >/dev/null 2>&1; then
      # Remove timezone info and try to parse
      local clean_date=$(echo "$timestamp" | sed 's/T/ /' | sed 's/[+-][0-9][0-9]:[0-9][0-9]$//')
      if date -d "$clean_date" "+%Y-%m-%d %H:%M:%S" 2>/dev/null; then
        return
      fi
    fi
    # If parsing fails, just return the original
    echo "$timestamp"
  fi
}

format_number() {
  local num="$1"
  if [ -z "$num" ] || [ "$num" = "null" ] || [ "$num" = "N/A" ]; then
    echo "N/A"
    return
  fi

  # add thousand separators for readability
  if command -v numfmt >/dev/null 2>&1; then
    numfmt --grouping "$num" 2>/dev/null || echo "$num"
  else
    echo "$num" | sed ':a;s/\B[0-9]\{3\}\>/,&/;ta'
  fi
}

make_request() {
  local method="$1"
  local endpoint="$2"
  local data="$3"
  local url="${API_BASE}/${endpoint}"

  [ "$argc_verbose" = 1 ] && printf "${dim}%s %s${reset}\n" "$method" "$url" >&2

  local response
  if [ "$method" = "GET" ]; then
    response=$(curl -s -H "x-api-key: ${API_KEY}" -H "accept: application/json" "$url")
  else
    [ "$argc_verbose" = 1 ] && printf "${dim}Payload: %s${reset}\n" "$data" >&2
    response=$(curl -s -X "$method" \
      -H "x-api-key: ${API_KEY}" \
      -H "accept: application/json" \
      -H "Content-Type: application/json" \
      -d "$data" \
      "$url")
  fi

  local curl_exit_code=$?
  if [ $curl_exit_code -ne 0 ]; then
    printf "${red}Error:${reset} Request failed (curl exit code: %d)\n" "$curl_exit_code" >&2
    exit 1
  fi

  if [ -z "$response" ]; then
    printf "${red}Error:${reset} Empty response from API\n" >&2
    exit 1
  fi

  if ! echo "$response" | jq empty 2>/dev/null; then
    printf "${red}Error:${reset} Invalid JSON response from API\n" >&2
    echo "Response: $response" >&2
    exit 1
  fi

  if echo "$response" | jq -e '.error' >/dev/null 2>&1; then
    error_msg=$(echo "$response" | jq -r '.error // .message // "Unknown error"')
    printf "${red}Error:${reset} TOTO API returned: ${red}%s${reset}\n" "$error_msg" >&2
    exit 1
  fi

  echo "$response"
}

build_user_payload() {
  local user="$1"
  local how="${argc_how:-username}"
  local page="${argc_page:-1}"

  if [ -z "$user" ]; then
    echo "${red}Error:${reset} User parameter is required" >&2
    exit 1
  fi

  if [ "$page" -lt 1 ]; then
    echo "${red}Error:${reset} Page number must be >= 1" >&2
    exit 1
  fi

  local payload="{\"user\": \"$user\", \"how\": \"$how\", \"page\": $page"
  [ "$argc_with_pfp" = 1 ] && payload="$payload, \"with_pfp\": true"
  [ -n "$argc_since" ] && payload="$payload, \"since\": \"$argc_since\""
  payload="$payload}"
  echo "$payload"
}

